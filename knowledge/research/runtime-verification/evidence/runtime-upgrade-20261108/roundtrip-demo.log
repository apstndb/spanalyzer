=== Generated DDL ===

CREATE TABLE Accounts (
  AccountId INT64 NOT NULL,
  Balance INT64 NOT NULL,
  CONSTRAINT BalancePositive CHECK (Balance >= 0)
) PRIMARY KEY (AccountId ASC);

CREATE TABLE Singers (
  SingerId INT64 NOT NULL,
  FirstName STRING(1024),
  LastName STRING(1024),
  SingerInfo BYTES(MAX),
  BirthDate DATE
) PRIMARY KEY (SingerId ASC);

CREATE TABLE Albums (
  SingerId INT64 NOT NULL,
  AlbumId INT64 NOT NULL,
  AlbumTitle STRING(MAX),
  MarketingBudget INT64
) PRIMARY KEY (SingerId ASC, AlbumId ASC),
  INTERLEAVE IN PARENT Singers ON DELETE CASCADE;

CREATE TABLE Events (
  EventId INT64 NOT NULL,
  EventName STRING(MAX),
  StartTime TIMESTAMP NOT NULL,
  CreatedAt TIMESTAMP NOT NULL OPTIONS (allow_commit_timestamp = true)
) PRIMARY KEY (EventId ASC);

CREATE TABLE Songs (
  SingerId INT64 NOT NULL,
  AlbumId INT64 NOT NULL,
  TrackId INT64 NOT NULL,
  SongName STRING(MAX),
  Duration INT64
) PRIMARY KEY (SingerId ASC, AlbumId ASC, TrackId ASC),
  INTERLEAVE IN PARENT Albums ON DELETE CASCADE;

CREATE NULL_FILTERED INDEX AlbumsByAlbumTitle ON Albums(AlbumTitle ASC) STORING (MarketingBudget);

CREATE INDEX SongsBySongName ON Songs(SongName ASC);

CREATE UNIQUE INDEX SongsBySingerAlbumSongNameDesc ON Songs(SingerId ASC, AlbumId ASC, SongName DESC), INTERLEAVE IN Albums;

CREATE VIEW SingerNames SQL SECURITY INVOKER AS SELECT Singers.SingerId, Singers.FirstName, Singers.LastName FROM Singers;

CREATE CHANGE STREAM SingerChangeStream FOR Singers;

CREATE SEQUENCE SingerIdSeq BIT_REVERSED_POSITIVE;

