+// PLAN collection deliberately retains partial results. Explicit measurement
+// must still fail if a planning/bootstrap error prevented its target execution;
+// the absence of an observation cannot turn the request into a successful no-op.
+func recordUnattemptedPlanReportMeasurements(report *planReport, inputs querygen.MutationCountInputs, attempted map[string]bool) {
+	var names []string
+	for name := range inputs.Writes {
+		if !attempted[name] {
+			names = append(names, name)
+		}
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		reason := "no eligible write target"
+		for i := range report.Queries {
+			query := &report.Queries[i]
+			if query.Scope != "write" || query.Name != name {
+				continue
+			}
+			if query.MutationCountError != "" {
+				reason = query.MutationCountError
+			} else if query.Error != "" {
+				reason = query.Error
+			}
+			query.MutationCountError = "measurement was not executed: " + reason
+			break
+		}
+		report.Warnings = append(report.Warnings, planReportDiagnostic{ID: "mutation-count-measurement-failed", Message: name + ": measurement was not executed: " + reason})
+	}
+}
