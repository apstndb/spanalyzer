+func (p *Parser) parseLabelUnary() ast.GQLLabelExpression {
+	switch {
+	case p.Token.Kind == "!":
+		notPos := p.expect("!").Pos
+		expr := p.parseGQLLabelExpressionBinary()
+		return &ast.GQLLabelNotExpression{Not: notPos, LabelExpression: expr}
+	case p.Token.Kind == "(":
+		lparen := p.expect("(").Pos
+		expr := p.parseGQLLabelExpressionBinary()
+		rparen := p.expect(")").Pos
+		return &ast.GQLLabelParenExpression{
+			Lparen:    lparen,
+			Rparen:    rparen,
+			LabelExpr: expr,
+		}
