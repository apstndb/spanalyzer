+func (p *Parser) parseGQLLabelPrimary() ast.GQLLabelPrimary {
+	pos := p.Token.Pos
+
+	if p.Token.Kind == "%" {
+		p.nextToken()
+		return &ast.GQLWildcardLabel{
+			Percent: pos,
+		}
+	}
+
+	ident := p.parseIdent()
+	return &ast.GQLElementLabel{
+		LabelName: ident,
+	}
