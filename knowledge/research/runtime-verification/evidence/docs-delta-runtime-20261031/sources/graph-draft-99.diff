+func (p *Parser) parseGQLReturnItem() *ast.GQLReturnItem {
+	if p.Token.Kind == "*" {
+		pos := p.expect("*").Pos
+		return &ast.GQLReturnItem{
+			Item: &ast.Star{
+				Star: pos,
+			},
+		}
+	}
+
+	expr := p.parseExpr()
+	as := p.tryParseAsAlias(withRequiredAs)
+	if as != nil {
+		return &ast.GQLReturnItem{
+			Item: &ast.Alias{
+				Expr: expr,
+				As:   as,
+			},
+		}
+	}
+	return &ast.GQLReturnItem{
+		Item: &ast.ExprSelectItem{
+			Expr: expr,
+		},
+	}
+
+}
