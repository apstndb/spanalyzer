+func (p *Parser) parseGQLFilterStatement() *ast.GQLFilterStatement {
+	filter := p.expectKeywordLike("FILTER").Pos
+	where := token.InvalidPos
+	if p.Token.Kind == "WHERE" {
+		where = p.expect("WHERE").Pos
+	}
+	expr := p.parseExpr()
+
+	return &ast.GQLFilterStatement{
+		Filter: filter,
+		Where:  where,
+		Expr:   expr,
+	}
