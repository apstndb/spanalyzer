+func (p *Parser) tryParseGQLPathModePathOrPaths() *ast.Ident {
+	switch {
+	case p.Token.IsKeywordLike("PATH"), p.Token.IsKeywordLike("PATHS"):
+		return p.parseIdent()
+	default:
+		return nil
+	}
