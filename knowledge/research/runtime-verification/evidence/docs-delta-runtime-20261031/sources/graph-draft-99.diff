+func (p *Parser) parseGQLForStatement() *ast.GQLForStatement {
+	forPos := p.expect("FOR").Pos
+	name := p.parseIdent()
+	p.expect("IN")
+	expr := p.parseExpr()
+
+	withOffset := p.tryParseGQLWithOffsetClause()
+
+	return &ast.GQLForStatement{
+		For:              forPos,
+		ElementName:      name,
+		ArrayExpression:  expr,
+		WithOffsetClause: withOffset,
+	}
+}
