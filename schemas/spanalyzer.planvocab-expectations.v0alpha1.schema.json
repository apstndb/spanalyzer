{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apstndb/spanalyzer/schemas/spanalyzer.planvocab-expectations.v0alpha1.schema.json",
  "title": "spanalyzer plan vocabulary expectations v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "queries"],
  "properties": {
    "version": {"const": "v0alpha1"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/query"}
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "patterns"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operatorPattern"}
        }
      }
    },
    "operatorPattern": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["display_name"]},
        {"required": ["family"]}
      ],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "metadata": {
          "type": "array",
          "items": {"$ref": "#/$defs/metadataRequirement"}
        },
        "child_links": {
          "type": "array",
          "items": {"$ref": "#/$defs/childLinkRequirement"}
        }
      }
    },
    "metadataRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"not": {"type": "null"}}
      }
    },
    "childLinkRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["KIND_UNSPECIFIED", "RELATIONAL", "SCALAR"]
        },
        "type": {"type": "string"},
        "variable": {
          "enum": ["any", "absent", "present"]
        },
        "min_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
