{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apstndb/spanalyzer/schemas/spanalyzer.information-schema-manifest.v0alpha2.schema.json",
  "title": "Spanalyzer INFORMATION_SCHEMA manifest v0alpha2",
  "description": "A generated managed-primary INFORMATION_SCHEMA analyzer projection bound to one explicit point-in-time observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "documentation",
    "content_sha256",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": "v0alpha2"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "registry_path",
        "registry_export_sha256",
        "selected_observation_path",
        "selected_observation_file_sha256",
        "observed_at",
        "surface_sha256",
        "producer_source_sha256",
        "invocation_sha256",
        "projection_source_path",
        "projection_source_sha256"
      ],
      "properties": {
        "repository": {
          "const": "github.com/apstndb/spanalyzer"
        },
        "registry_path": {
          "const": "survey/infoschem"
        },
        "registry_export_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selected_observation_path": {
          "type": "string",
          "pattern": "^survey/infoschem/evidence/managed/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}\\.json$"
        },
        "selected_observation_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "surface_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "invocation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_source_path": {
          "const": "information_schema_projection_source.json"
        },
        "projection_source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "last_updated"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "raw_type",
        "evidence_status",
        "project"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "raw_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "enum": [
            "live_observed",
            "rolling",
            "docs_only_absent"
          ]
        },
        "project": {
          "type": "boolean"
        },
        "projected_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": {
                "enum": [
                  "live_observed",
                  "rolling"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ordinal"
            ],
            "properties": {
              "project": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "docs_only_absent"
              }
            }
          },
          "then": {
            "properties": {
              "project": {
                "const": false
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ordinal"
                  ]
                },
                {
                  "required": [
                    "projected_type"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "raw_type": {
                "pattern": "^PROTO<"
              },
              "evidence_status": {
                "enum": [
                  "live_observed",
                  "rolling"
                ]
              }
            }
          },
          "then": {
            "required": [
              "projected_type"
            ]
          },
          "else": {
            "not": {
              "required": [
                "projected_type"
              ]
            }
          }
        }
      ]
    }
  }
}
