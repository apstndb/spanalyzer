{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apstndb/spanalyzer/schemas/runtime-targets.v0alpha1.schema.json",
  "title": "Spanalyzer pinned runtime targets v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "targets"],
  "properties": {
    "$schema": {
      "const": "schemas/runtime-targets.v0alpha1.schema.json"
    },
    "schema_version": {
      "const": "v0alpha1"
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "image_family", "tag", "platforms"],
        "properties": {
          "kind": {
            "enum": ["emulator", "omni"]
          },
          "image_family": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
          },
          "platforms": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "digest"],
              "properties": {
                "platform": {
                  "enum": ["linux/amd64", "linux/arm64"]
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
