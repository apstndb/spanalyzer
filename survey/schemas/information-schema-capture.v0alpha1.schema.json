{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apstndb/spanalyzer/survey/schemas/information-schema-capture.v0alpha1.schema.json",
  "title": "INFORMATION_SCHEMA target capture",
  "description": "A redacted point-in-time observation of one target's INFORMATION_SCHEMA definition surface and bounded rolling-column queryability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog",
    "dialect",
    "target",
    "observed_at",
    "producer_source_sha256",
    "invocation_sha256",
    "query",
    "surface_sha256",
    "columns",
    "rolling_queryability"
  ],
  "properties": {
    "schema_version": {
      "const": "v0alpha1"
    },
    "catalog": {
      "const": "INFORMATION_SCHEMA"
    },
    "dialect": {
      "const": "googlesql"
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/managedTarget"
        },
        {
          "$ref": "#/$defs/containerTarget"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "invocation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "query": {
      "const": "SELECT TABLE_NAME, COLUMN_NAME, SPANNER_TYPE, ORDINAL_POSITION\nFROM INFORMATION_SCHEMA.COLUMNS\nWHERE TABLE_SCHEMA = 'INFORMATION_SCHEMA'\nORDER BY TABLE_NAME, ORDINAL_POSITION"
    },
    "surface_sha256": {
      "description": "SHA-256 of the canonical compact JSON encoding of columns plus rolling_queryability.",
      "$ref": "#/$defs/sha256"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "rolling_queryability": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/rollingQueryability"
            },
            {
              "properties": {
                "table_name": {
                  "const": "INDEXES"
                },
                "column_name": {
                  "const": "SEARCH_UNNEST"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/rollingQueryability"
            },
            {
              "properties": {
                "table_name": {
                  "const": "INDEX_COLUMNS"
                },
                "column_name": {
                  "const": "EXPRESSION"
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "managedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observation_scope"
      ],
      "properties": {
        "kind": {
          "const": "managed"
        },
        "observation_scope": {
          "const": "single_database"
        }
      }
    },
    "containerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "image"
      ],
      "properties": {
        "kind": {
          "enum": [
            "omni",
            "emulator"
          ]
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "tag",
        "digest",
        "platform"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@\\s]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^linux/(amd64|arm64)(/v[0-9]+)?$"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "column_name",
        "spanner_type",
        "ordinal_position"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "minLength": 1
        },
        "column_name": {
          "type": "string",
          "minLength": 1
        },
        "spanner_type": {
          "type": "string",
          "minLength": 1
        },
        "ordinal_position": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rollingQueryability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "column_name",
        "status"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "minLength": 1
        },
        "column_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "advertised_not_queryable",
            "not_advertised",
            "queryable"
          ]
        },
        "status_code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNIMPLEMENTED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "advertised_not_queryable"
              }
            }
          },
          "then": {
            "required": [
              "status_code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "status_code"
              ]
            }
          }
        }
      ]
    }
  }
}
